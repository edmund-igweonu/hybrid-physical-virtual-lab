# Copy to .env and fill in. .env is gitignored.

# TACACS+ account used for 881-R1, 881-R2 and the 2950
LAB_USER=
LAB_PASS=
# Only needed if the account doesn't land at privilege 15
LAB_ENABLE=

# GNS3 server, used to look up the carrier routers' console ports
GNS3_URL=http://127.0.0.1:3080
GNS3_PROJECT=20-noc-in-a-box
# Leave blank if the GNS3 server has no auth
GNS3_USER=
GNS3_PASS=
